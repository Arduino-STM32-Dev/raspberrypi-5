# ============================================================
# 树莓派多模态 AI 桌面助手 —— 环境变量模板
# 用法：复制本文件为 .env，填入真实 Key
#   cp .env.example .env
#
# ⚠️ .env 已在 .gitignore 中被忽略，请勿提交真实密钥
# ============================================================

# 阿里云百炼（DashScope）API Key
# 用途：语音识别 qwen3-asr-flash、视觉识别 qwen-vl-plus
# 获取：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-你的阿里云百炼API_KEY

# DeepSeek 开放平台 API Key
# 用途：对话思考 deepseek-flash
# 获取：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-你的DeepSeek_API_Key

# ------------------------------------------------------------
# 硬件设备参数（换机器时需要改这里）
# 先用 arecord -l / aplay -l 确认自己的 USB 声卡 card 号
# ------------------------------------------------------------
MIC_DEVICE=plughw:2,0
SPEAKER_DEVICE=plughw:2,0
CAMERA_DEVICE=/dev/video0

# 本地 TTS 模型目录（sherpa-onnx-vits-zh-ll 解压后的路径）
TTS_MODEL_DIR=/home/pi/deepseek_project/sherpa-onnx-vits-zh-ll
